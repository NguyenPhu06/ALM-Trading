POSTGRES_USER=alm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alm_trading
DATABASE_URL=postgresql+psycopg://alm:change-me@db:5432/alm_trading
TRADINGVIEW_WEBHOOK_SECRET=change-me-to-a-long-random-secret
LIVE_TRADING_ENABLED=false
DEMO_TRADING_ENABLED=false
LOG_LEVEL=INFO
MARKET_DATA_PROVIDER=historical
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://api.twelvedata.com
MARKET_DATA_TIMEOUT=30
MARKET_DATA_RATE_LIMIT=8
MARKET_DATA_MAX_RETRIES=3
MARKET_DATA_BACKOFF_SECONDS=1

# --- Phase 10: MetaTrader 5, READ-ONLY, DEMO account only ---
TRADING_ENVIRONMENT=DEMO
READ_ONLY_MODE=true
MT5_ENABLED=false
MT5_READ_ONLY=true
MT5_EXECUTION_ENABLED=false
# Real values belong in .env only. Never commit them, never log them.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
MT5_BROKER=Exness
MT5_MAGIC_NUMBER=0
MT5_TIMEOUT_MS=30000
# Set when the API runs in Docker and the terminal runs on a Windows host.
MT5_BRIDGE_URL=
MT5_BRIDGE_TOKEN=
