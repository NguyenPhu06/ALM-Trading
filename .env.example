POSTGRES_USER=alm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alm_trading
DATABASE_URL=postgresql+psycopg://alm:change-me@db:5432/alm_trading
TRADINGVIEW_WEBHOOK_SECRET=change-me-to-a-long-random-secret
LIVE_TRADING_ENABLED=false
DEMO_TRADING_ENABLED=false
LOG_LEVEL=INFO
MARKET_DATA_PROVIDER=historical
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://api.twelvedata.com
MARKET_DATA_TIMEOUT=30
MARKET_DATA_RATE_LIMIT=8
MARKET_DATA_MAX_RETRIES=3
MARKET_DATA_BACKOFF_SECONDS=1

# --- Phase 10: MetaTrader 5, READ-ONLY, DEMO account only ---
TRADING_ENVIRONMENT=DEMO
READ_ONLY_MODE=true
MT5_ENABLED=false
MT5_READ_ONLY=false
MT5_EXECUTION_ENABLED=false
# Real values belong in .env only. Never commit them, never log them.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
MT5_BROKER=Exness
MT5_MAGIC_NUMBER=0
MT5_TIMEOUT_MS=30000
# Set when the API runs in Docker and the terminal runs on a Windows host.
MT5_BRIDGE_URL=
MT5_BRIDGE_TOKEN=

# --- Phase 11: manual DEMO execution. All three gates closed by default. ---
# An order requires DEMO_TRADING_ENABLED=true AND MT5_EXECUTION_ENABLED=true AND
# EXECUTION_KILL_SWITCH=false, plus a verified DEMO account. Never enable on a REAL account.
EXECUTION_KILL_SWITCH=true
DEMO_EXECUTION_MAX_VOLUME=0.10
DEMO_EXECUTION_SYMBOLS=
EXECUTION_AUDIT_ENABLED=true

# --- Phase 12: live market validation. Observe everything, send nothing. ---
OBSERVATION_MODE=true
OBSERVATION_SYMBOLS=EURUSD
OBSERVATION_INTERVAL_SECONDS=60

# --- Phase 13: learning is an explicit job; a model never promotes itself. ---
AI_TRAINING_ENABLED=true
AI_AUTO_PROMOTE=false
AI_ONLINE_LEARNING_ENABLED=false

# Phase 14 - forward observation loop. The driver observes; it never executes.
OBSERVATION_DRIVER_ENABLED=false
AI_MANUAL_TRAINING=true
# Refused at startup if true: training must stay a manual job.
AI_AUTOMATIC_TRAINING=false

# --- Phase 16: controlled MT5 DEMO trading. LIVE remains impossible. ---
# The mode is the single source of truth for what the system may do. There is no
# implicit switching: a closed gate blocks the ORDER, never the MODE.
#   OBSERVATION | PAPER | DEMO_MANUAL_APPROVAL | DEMO_AUTOMATED | LIVE_DISABLED
DEMO_EXECUTION_MODE=OBSERVATION
# Refused at startup if true: only verified DEMO accounts may ever execute.
REAL_ACCOUNT_EXECUTION=false
# DEMO_AUTOMATED needs this as well, so reaching automated execution takes two
# deliberate settings rather than one.
DEMO_AUTOMATED_EXECUTION_ENABLED=false
# Every DCA order re-runs the whole gate chain. There is no martingale anywhere.
DEMO_DCA_ENABLED=false
# The trading-day boundary, named explicitly so a daily limit is never ambiguous.
DEMO_TRADING_TIMEZONE=UTC
DEMO_TRADING_DAY_RESET_HOUR=0

# --- Phase 17: shadow trading and DEMO validation. LIVE remains impossible. ---
# SHADOW runs the identical pipeline to DEMO and stops before the broker call.
# It is one of the six values DEMO_EXECUTION_MODE accepts, and it needs none of
# the broker flags open because it reaches no broker.
#
# Shadow RECORDING is on by default and is not a mode: every DEMO candidate,
# taken or blocked, produces a shadow record. It has no transport.
SHADOW_MODE_ENABLED=true
# The circuit breaker survives an operator releasing the kill switch, so recovery
# needs a health check, a risk check, account validation and a named human.
# Turning it off does not enable execution; it removes an automatic reason to stop.
CIRCUIT_BREAKER_ENABLED=true
# Records that a human accepted the computed DEMO_AUTOMATION_ELIGIBLE finding.
# NOT sufficient on its own: DEMO_AUTOMATED still needs its own opt-in above.
DEMO_AUTOMATION_APPROVED=false
